# Copy this file to `.env` and fill in your keys.
# Both keys are OPTIONAL — the pipeline degrades gracefully without them.

# Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs)
# Without this key, fundamentals fall back to yfinance (lower coverage / quality).
FMP_API_KEY=

# DeepSeek (https://platform.deepseek.com)
# Without this key, each bear case is generated from a deterministic template
# instead of an LLM that has read the latest earnings transcript and news.
DEEPSEEK_API_KEY=

# Optional overrides
# QVM_OUTPUT_DIR=output
# QVM_CAPITAL=10000
